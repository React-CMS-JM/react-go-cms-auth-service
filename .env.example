# Template for local (.env) and production (.env.production) files.
# Copy to .env for localhost, or fill in prod values for Cloud Run / Secret Manager.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
# PREFERRED = local MySQL; VERIFY_IDENTITY = TiDB Cloud
DB_SSL_MODE=PREFERRED
# Raw HMAC secret (>=32 chars). Auth signs and all 3 services verify with this.
# NEVER reuse the local value in production.
JWT_SECRET=change-me
# Must be identical in all 3 services (content/courses verify auth's tokens)
JWT_ISSUER=
JWT_LIFESPAN=3600
# Comma-separated; prod adds the frontend origin, e.g. https://your-app.web.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
HTTP_PORT=8081
